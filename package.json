{
  "name": "agent-council",
  "version": "0.1.0",
  "description": "Three-provider research council for Codex, Claude, and GitHub Copilot CLIs",
  "type": "module",
  "bin": {
    "council": "dist/cli.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.tsx",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "string-width": "^8.2.2",
    "wrap-ansi": "^9.0.2",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
